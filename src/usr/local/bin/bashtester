#!/bin/bash

# Define colors
BLACK='\033[0;30m'
LIGHT_BLACK='\033[1;30m'
RED='\033[0;31m'
LIGHT_RED='\033[1;31m'
GREEN='\033[0;32m'
LIGHT_GREEN='\033[1;32m'
BROWN_ORANGE='\033[0;33m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
LIGHT_BLUE='\033[1;34m'
PURPLE='\033[0;35m'
LIGHT_PURPLE='\033[1;35m'
CYAN='\033[0;36m'
LIGHT_CYAN='\033[1;36m'
LIGHT_GRAY='\033[0;37m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color

##############
## help functions
########


failing_test(){
  faulty_tests+=("${FUNCNAME[2]}")
}

assert_equal() {
  local testname=$1
  local expected=$2
  local actual=$3
  if [ "$expected" != "$actual" ]; then
    echo -e "${RED}Assertion failed: $testname: expected '$expected', got '$actual'${NC}"
    failing_test "$testname"
    exit_code=1
  else
    echo -e "${GREEN}Assertion passed: $testname${NC}"
  fi
}

assert_not_equal() {
  local testname=$1
  local expected=$2
  local actual=$3
  if [ "$expected" == "$actual" ]; then
    echo -e "${RED}Assertion failed: $testname: expected '$expected' to not equal '$actual'${NC}"
    failing_test "$testname"
    exit_code=1 
  else
    echo -e "${GREEN}Assertion passed: $testname${NC}"
  fi
}

check_last_command(){
  last_command_exit=$?
  local expected_exit=$1
  function_name=${FUNCNAME[1]}
  assert_equal "Check command in: $function_name" "$expected_exit" "$last_command_exit"
}

color_block() {
  color=$1
  block=$2
  write_line "$color"
  echo -e "${!color}$block${NC}"
  write_line "$color"
}

write_line() {
  color=$1
  color=$(echo "$color" | tr '[:lower:]' '[:upper:]')
  echo -e "${!color}--------------------------------------------------------------------------------------------${NC}"
}

#########################
## Internal functions
###########################

special_functions="before_all after_all"

run_tests() {
  source "$1"
  function_list=$(get_fcn_list "$1")
  if [[ "$function_list" == *"before_all"* ]]; then
    before_all
  fi
  for fcn in $function_list; do
    if [[ "$special_functions" != *"$fcn"* ]]; then
      color_block blue "Starting test: \"$fcn\" in $1"
      $fcn
      color_block blue "Finished test: \"$fcn\" in $1"
    fi
  done
  if [[ "$function_list" == *"after_all"* ]]; then
    after_all
  fi
}

#  Get the list of functions defined in a given bash script file using get_fcn_list function.
get_fcn_list() {
  env -i bash --noprofile --norc -c '
    source "'"$1"'"
    typeset -f |
    grep '\''^[^{} ].* () $'\'' |
    awk "{print \$1}" |
    while read -r fcn_name; do
        type "$fcn_name" | head -n 1 | grep -q "is a function$" || continue
        # skip function that starts with _
        [[ "$fcn_name" == _* ]] && continue
        echo "$fcn_name"
    done
  '
}

#########################
## Run the actual tests.
#########################


# If no path is provided, use the current directory
if [ -n "$1" ]; then
  # run all files named *.test in $path
  path=$1
else
  path="."
fi

path=$(realpath "$path")
echo -e "${LIGHT_BLUE}BashTester running tests in: $path${NC}"
export TEST_PATH="$path"

## Stat variables
exit_code=0
number_of_tests=0
test_files=()
faulty_tests=()


if [ -d "$path" ]; then
  for test_file in "$path"/*.test; do
    test_files+=($(basename "$test_file"))
    echo -e "${YELLOW}Running test file: $test_file${NC}"
    run_tests "$test_file"
    echo -e "${YELLOW}Test file $test_file has been executed.${NC}"
  done
elif [ -f "$path" ] && [[ "$path" == *.test ]]; then
  echo -e "${YELLOW}Running test file: $path${NC}"
  test_files+=($(basename "$path"))
  run_tests "$path"
  echo -e "${YELLOW}Test file $path has been executed.${NC}"
else
  echo -e "${RED}Error: Directory $path does not exist.${NC}"
  exit 1
fi

cd $(dirname "$0")

  echo -e "${GREEN}Test files executed: ${test_files[@]}${NC}"
if [ $exit_code -eq 0 ]; then
  echo -e "${GREEN}All tests passed!${NC}"
else
  echo -e "${RED}Some tests failed.${NC}"
  echo -e "${RED}Faulty tests: ${faulty_tests[@]}${NC}"
fi

exit $exit_code
